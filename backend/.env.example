PORT=4000
FRONTEND_ORIGIN=http://localhost:4173
PUBLIC_APP_URL=http://localhost:4173
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY
GENUINENG_ED25519_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
GENUINENG_ED25519_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY\n-----END PUBLIC KEY-----"
GENUINENG_KEY_VERSION=1
# Optional JSON key ring for old public keys after rotation:
# GENUINENG_ED25519_PUBLIC_KEYS={"1":"-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"}
MANUFACTURER_PORTAL_ENABLED=true

# EmailJS partner approval workflow. You can copy the same service/public key
# values already used by the frontend EmailJS setup into the backend .env.
EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
EMAILJS_PUBLIC_KEY=YOUR_EMAILJS_PUBLIC_KEY
EMAILJS_PARTNER_APPLICATION_TEMPLATE_ID=YOUR_PARTNER_APPLICATION_TEMPLATE_ID
EMAILJS_PARTNER_APPROVED_TEMPLATE_ID=YOUR_PARTNER_APPROVED_TEMPLATE_ID

# Comma-separated GenuineNG accounts allowed to approve applications.
# The same addresses receive the new-partner application emails.
PARTNER_ADMIN_EMAILS=admin@example.com,developer@example.com
# Approval links expire after 72 hours by default (maximum supported here: 168).
PARTNER_APPROVAL_TOKEN_HOURS=72
